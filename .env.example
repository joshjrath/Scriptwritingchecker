# Copy to .env and fill in. Never commit the real file (.env is git-ignored).
#
# 1. Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# 2. Your Discord user ID: Settings -> Advanced -> Developer Mode,
#    then right-click yourself -> Copy User ID
SCRIPTCHECK_MY_USER_ID=

# 3. Where alerts go: any channel you control -> Edit Channel ->
#    Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
SCRIPTCHECK_WEBHOOK_URL=

# 4. Password for the live board. Generate one with:
#    python -c "import secrets; print(secrets.token_urlsafe(24))"
#    Without it, anyone with the URL can read your assignments.
SCRIPTCHECK_ACCESS_TOKEN=
